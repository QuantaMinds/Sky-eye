# Copy to .env and fill in. Never commit .env.
# Gemini is called via Vertex AI using Application Default Credentials —
# no GEMINI_API_KEY needed. Run `gcloud auth application-default login` once,
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON.

# --- Gemini via Vertex AI ---
GEMINI_MODEL=gemini-2.5-flash
VERTEX_AI_LOCATION=us-central1

# --- Google Cloud (Vertex AI, BigQuery, GCS, Earth Engine) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Earth Engine (optional for Phase 1) ---
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_FILE=

# --- Google Solar API (Maps Platform key — enable Solar API + Geocoding API) ---
GOOGLE_SOLAR_API_KEY=

# --- Census Bureau API ---
CENSUS_API_KEY=

# --- NREL Developer API (PVWatts) ---
NREL_API_KEY=

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
