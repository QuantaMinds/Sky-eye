# Copy to .env and fill in. Never commit .env.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Google Cloud (BigQuery, GCS, Earth Engine) ---
GOOGLE_CLOUD_PROJECT=
# Absolute path to a service-account JSON used for Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Earth Engine ---
EARTH_ENGINE_PROJECT=
# Optional: if using a service-account flow rather than ADC for EE.
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_FILE=

# --- Google Solar API (Maps Platform key) ---
GOOGLE_SOLAR_API_KEY=

# --- Census Bureau API ---
CENSUS_API_KEY=

# --- NREL Developer API (PVWatts) ---
NREL_API_KEY=

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
