# Virtual environments
eye/
.venv/
venv/
env/

# Secrets — never commit
.env
.env.local
.env.*.local
*.key
*.pem
service-account*.json
credentials.json
gcp-key*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# Local cache (Solar API ToS cache + dev cost saver)
.cache.db
.cache.db-journal

# Local data staging — raw downloads, gzipped CSVs, reprojected NDJSON,
# unzipped shapefiles. Never commit — pulled fresh from the source on demand.
.stage/

# Portable binaries (GDAL/ogr2ogr unpacked here, ~hundreds of MB).
.tools/

# Compressed / binary archive formats — too large for git, fetched on demand
*.zip
*.gz
*.tar
*.tgz
*.7z

# Shapefile components — geometry archives belong in GCS, not git
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.prj
*.cpg
*.shp.xml
*.qix

# Reprojected / intermediate geo formats
*.jsonl
*.geojsonl
*.gdb/
*.gpkg

# Native binaries (Windows portable installs of GDAL etc.)
*.dll
*.exe
*.lib
*.pdb

# Tests / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Pilot deliverable artifacts — generated CSVs with LA County address /
# owner / mailing data. Outputs of scripts/12_*..14_* — regenerate locally.
# Never committed: PII (owner names, mailing addresses after Tier-2 scrape)
# must not enter git history.
out/
